---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import star from '../assets/star.png';
import { getReleases, pigments, year, spotifyUrl, outDate, ARTIST, HOUSE_PIGMENTS } from '../lib/releases';

const releases = await getReleases();
const songs = releases.filter((r) => !r.data.draft && r.data.spotify).reduce((n, r) => n + r.data.tracks, 0);
const latest = releases[0];

const wall = await Promise.all(releases.map(async (r) => ({ r, pigments: await pigments(r) })));

const playable = await Promise.all(
  releases
    .filter((r) => r.data.preview)
    .map(async (r) => ({
      slug: r.id,
      title: r.data.title,
      preview: r.data.preview,
      art: (await getImage({ src: r.data.cover, width: 96, format: 'webp' })).src,
      out: spotifyUrl(r),
      pigments: await pigments(r),
    }))
);
// Beneath is the most-streamed song, so it's the one on deck.
playable.sort((a, b) => Number(b.slug === 'beneath') - Number(a.slug === 'beneath'));
const first = playable[0];

const places = [
  ['Spotify', ARTIST.spotify],
  ['Apple Music', ARTIST.appleMusic],
  ['SoundCloud', ARTIST.soundcloud],
  ['YouTube', ARTIST.youtube],
  ['Bandcamp', ARTIST.bandcamp],
  ['TikTok', ARTIST.tiktok],
  ['Facebook', ARTIST.facebook],
];

const description = 'Electronic music duo crafting immersive sonic landscapes inspired by the Mediterranean coastline and surrealist art.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Lost in Tropez',
  url: Astro.site,
  description,
  sameAs: Object.values(ARTIST),
};
---
<Base title="Lost in Tropez" {description} {jsonLd}>
  <header class="top">
    <a href="/" aria-label="Lost in Tropez, home"><Image src={star} alt="" width={88} height={88} loading="eager" /></a>
    <nav class="label" aria-label="Main">
      <a href="#releases">Releases</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <h1><span>Lost in</span><span>Tropez</span></h1>
      <p class="voice">Took a wrong turn in Baja.</p>
      <a class="latest" href={`/${latest.id}/`}>
        {latest.data.spotify ? `Latest: ${latest.data.title}` : `Out ${outDate(latest)}: ${latest.data.title}`} <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="wall" id="releases">
      <div class="wall-head">
        <h2>Releases</h2>
        <p>{songs} songs since May 2020</p>
      </div>
      <div class="hang">
        {wall.map(({ r, pigments: p }, i) => (
          <a class={`work w${((i < 10 ? i : i + 3) % 10) + 1}`} href={`/${r.id}/`} data-pigments={JSON.stringify(p)}>
            <Image src={r.data.cover} alt={`${r.data.title} cover`} widths={[360, 720]} sizes="(max-width: 720px) 80vw, 33vw" format="webp" quality={80} />
            <span class="card"><b>{r.data.title}</b><i>{r.data.kind}, {year(r)}</i></span>
          </a>
        ))}
      </div>
    </section>

    <section class="about" id="about">
      <Image src={star} alt="The Lost in Tropez star" widths={[420, 840]} sizes="(max-width: 720px) 62vw, 40vw" />
      <div>
        <blockquote>Took a wrong turn in Baja.</blockquote>
        <p>{description}</p>
        <p>Influenced by Polo &amp; Pan, ODESZA, Louis The Child, Lane 8, and Nora En Pure.</p>
      </div>
    </section>

    <section class="contact" id="contact">
      <h2>Connect With Us</h2>
      <div class="contact-grid">
        <form id="contact-form" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="visually-hidden"><label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <label><span class="label">Email</span><input type="email" name="email" placeholder="your@email.com" autocomplete="email" required /></label>
          <label><span class="label">Message</span><textarea name="message" rows="3" placeholder="Bookings, collaborations, or just to say hello..." required></textarea></label>
          <button class="send" type="submit">Send message</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>
        <ul class="places">
          {places.map(([name, url]) => (
            <li><a href={url} target="_blank" rel="noopener">{name}<span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </div>
      <p class="fine"><a href="/privacy/">Privacy</a></p>
    </section>
  </main>

  {first && (
    <aside class="deck" id="deck" aria-label="Player">
      <img id="deckArt" src={first.art} alt="" width="48" height="48" />
      <div class="deck-title">
        <a id="deckTitle" href={`/${first.slug}/`}>{first.title}</a>
        <i>30-second preview</i>
      </div>
      {playable.length > 1 && (
        <button class="btn-round next" id="next" aria-label="Next track">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 4l11 8-11 8V4zm13 0h2v16h-2z" /></svg>
        </button>
      )}
      <button class="btn-round play" id="play" aria-label="Play">
        <svg id="iconPlay" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 3.5l15 8.5-15 8.5z" /></svg>
        <svg id="iconPause" class="hide" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zm8 0h4v16h-4z" /></svg>
      </button>
      <a class="out label" id="deckOut" href={first.out} target="_blank" rel="noopener">Spotify ↗</a>
      <audio id="audio" preload="none"></audio>
    </aside>
  )}

  <script id="home-data" type="application/json" set:html={JSON.stringify({ playable, house: HOUSE_PIGMENTS })}></script>
</Base>

<script>
  import '../scripts/home.js';
</script>

<style is:global>
  :root { --deck: 72px; }
  .top {
    position: absolute; inset: 0 0 auto; display: flex; justify-content: space-between; align-items: center;
    padding: 18px var(--gutter); z-index: 2;
  }
  .top img { width: 44px; height: 44px; display: block; mix-blend-mode: multiply; }
  .top nav { display: flex; gap: clamp(16px, 3vw, 36px); }
  .top nav a { text-decoration: none; padding: 10px 0; }
  .top nav a:hover { text-decoration: underline; text-underline-offset: 5px; }

  .hero {
    min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 80px var(--gutter) calc(var(--deck) + 32px); text-align: center;
  }
  h1 {
    margin: 0; font: 400 min(21vw, 27svh)/.92 Marcellus, serif; letter-spacing: -.012em; text-transform: uppercase;
    mix-blend-mode: multiply; color: var(--ink);
  }
  h1 span { display: block; }
  .voice { margin: clamp(16px, 3svh, 30px) 0 0; font: italic 500 clamp(22px, 2.7vw, 34px)/1.2 'Cormorant Garamond', serif; mix-blend-mode: multiply; }
  .latest { margin-top: clamp(10px, 1.6svh, 16px); padding: 8px 2px; text-underline-offset: 5px; }

  .wall { padding: clamp(48px, 9vw, 120px) var(--gutter); }
  .wall-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; border-top: 1px solid var(--rule); padding-top: 14px; margin-bottom: clamp(32px, 6vw, 84px); }
  h2 { margin: 0; font: 400 clamp(38px, 6vw, 84px)/1 Marcellus, serif; mix-blend-mode: multiply; }
  .wall-head p { margin: 0; color: var(--ink-2); }
  .hang { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(12px, 2.4vw, 36px); row-gap: clamp(36px, 6vw, 88px); align-items: start; }
  .work { display: block; text-decoration: none; }
  .work img {
    display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; background: #ddd5c4;
    box-shadow: 0 1px 2px rgba(29, 21, 33, .28), 0 22px 36px -22px rgba(29, 21, 33, .55);
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s;
  }
  .work:hover img { transform: translateY(-5px); box-shadow: 0 1px 2px rgba(29, 21, 33, .28), 0 34px 48px -24px rgba(29, 21, 33, .6); }
  .card { display: block; margin-top: 12px; }
  .card b { display: block; font: 400 clamp(17px, 1.6vw, 22px)/1.2 Marcellus, serif; }
  .card i { display: block; font-style: normal; font-size: 14px; color: var(--ink-2); }
  .w1 { grid-column: 1 / 6; }
  .w2 { grid-column: 7 / 10; margin-top: 16%; }
  .w3 { grid-column: 10 / 13; margin-top: -4%; }
  .w4 { grid-column: 2 / 5; }
  .w5 { grid-column: 5 / 9; margin-top: 10%; }
  .w6 { grid-column: 9 / 13; margin-top: -6%; }
  .w7 { grid-column: 1 / 4; margin-top: 6%; }
  .w8 { grid-column: 4 / 7; margin-top: -8%; }
  .w9 { grid-column: 7 / 10; margin-top: 8%; }
  .w10 { grid-column: 10 / 13; }
  @media (max-width: 720px) {
    .hang { grid-template-columns: repeat(6, 1fr); }
    .w1, .w5, .w9 { grid-column: 1 / 6; margin-top: 0; }
    .w2, .w6, .w10 { grid-column: 1 / 4; margin-top: 0; }
    .w3, .w7 { grid-column: 4 / 7; margin-top: 18%; }
    .w4 { grid-column: 2 / 7; margin-top: 0; }
    .w8 { grid-column: 3 / 7; margin-top: 0; }
    .wall-head { flex-direction: column; gap: 6px; }
  }

  .about { padding: clamp(48px, 8vw, 120px) var(--gutter); display: grid; grid-template-columns: 5fr 6fr; gap: clamp(24px, 6vw, 96px); align-items: center; }
  .about img { width: 100%; height: auto; max-width: 520px; justify-self: center; display: block; mix-blend-mode: multiply; }
  .about blockquote { margin: 0 0 22px; font: italic 500 clamp(34px, 5vw, 68px)/1.04 'Cormorant Garamond', serif; mix-blend-mode: multiply; }
  .about p { margin: 0 0 14px; max-width: 34em; }
  @media (max-width: 720px) { .about { grid-template-columns: 1fr; } .about img { max-width: 62vw; } }

  .contact { padding: clamp(48px, 8vw, 120px) var(--gutter) calc(var(--deck) + 40px); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 6vw, 96px); margin-top: clamp(24px, 4vw, 48px); border-top: 1px solid var(--rule); padding-top: 22px; }
  .contact form > label { display: block; margin-bottom: 22px; }
  .contact form > label > span { display: block; margin-bottom: 4px; }
  input:not([type='hidden']), textarea {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0; padding: 10px 0;
    font: 400 18px/1.4 Jost, sans-serif; color: var(--ink); resize: vertical;
  }
  input::placeholder, textarea::placeholder { color: var(--ink-2); opacity: .75; }
  .send { border: 0; background: var(--ink); color: var(--paper); font: 500 16px Jost, sans-serif; padding: 15px 30px; cursor: pointer; }
  .send:disabled { opacity: .6; cursor: default; }
  .form-status { min-height: 1.5em; margin: 12px 0 0; }
  .places { list-style: none; margin: 0; padding: 0; }
  .places a { display: flex; justify-content: space-between; padding: 13px 0; border-bottom: 1px solid var(--rule); text-decoration: none; font: 400 clamp(21px, 2.4vw, 30px)/1.15 Marcellus, serif; }
  .places a:hover { padding-left: 8px; transition: padding .25s; }
  .fine { margin: 32px 0 0; font-size: 13.5px; color: var(--ink-2); }
  @media (max-width: 720px) { .contact-grid { grid-template-columns: 1fr; } }

  .deck {
    position: fixed; inset: auto 0 0; height: calc(var(--deck) + env(safe-area-inset-bottom)); padding: 0 var(--gutter) env(safe-area-inset-bottom);
    display: flex; align-items: center; gap: 14px; z-index: 5;
    background: color-mix(in srgb, var(--paper) 84%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-top: 1px solid var(--rule);
  }
  .deck::before { content: ''; position: absolute; left: 0; top: -1px; height: 2px; width: calc(var(--p, 0) * 100%); background: var(--ink); }
  .deck img { width: 48px; height: 48px; object-fit: cover; flex: none; }
  .deck-title { min-width: 0; flex: 1; line-height: 1.2; }
  .deck-title a { display: block; font: 400 19px/1.2 Marcellus, serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none; }
  .deck-title a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .deck-title i { font-style: normal; font-size: 13.5px; color: var(--ink-2); }
  .btn-round { width: 48px; height: 48px; border-radius: 50%; border: 0; display: grid; place-items: center; cursor: pointer; flex: none; }
  .play { background: var(--ink); color: var(--paper); }
  .next { background: transparent; color: var(--ink); }
  .deck .out { text-decoration: none; padding: 12px 0 12px 10px; white-space: nowrap; }
  @media (max-width: 520px) { .deck .out { display: none; } }
</style>
